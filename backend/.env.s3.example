# Add to backend/.env ONLY when testing S3. Never commit backend/.env.
# Keep default local for the standard offline demo.
STORAGE_BACKEND=s3
AWS_S3_BUCKET=replace-with-your-private-bucket
AWS_REGION=us-east-1
S3_KEY_PREFIX=hospitality-documents
# Boto3 uses an IAM role, AWS_PROFILE, or other AWS credential-chain source.
# Never put an AWS secret key into Git.
